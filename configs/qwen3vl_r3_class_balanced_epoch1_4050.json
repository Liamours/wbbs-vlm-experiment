{
  "model_id": "Qwen/Qwen3-VL-2B-Instruct",
  "task": "multitask",
  "output_schema": "multitask_json",
  "selection_metric": "multitask_macro",
  "sampling": {
    "mode": "class_balanced"
  },
  "train_jsonl": "datasets/training-exports/qwen3_json/r3/multitask_train.jsonl",
  "eval_jsonl": "datasets/training-exports/qwen3_json/r3/multitask_val.jsonl",
  "adapter": {
    "rank": 8,
    "alpha": 16,
    "dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "runtime": {
    "output_dir": "results/weights/r3-qwen3vl/r3-class-balanced-qwen3vl-2b-epoch1-4050",
    "batch_size": 1,
    "gradient_accumulation": 8,
    "learning_rate": 5e-05,
    "weight_decay": 0.01,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_epsilon": 1e-08,
    "warmup_ratio": 0.03,
    "max_grad_norm": 1.0,
    "epochs": 2,
    "max_target_tokens": 96,
    "min_pixels": 50176,
    "max_pixels": 50176,
    "gradient_checkpointing": true,
    "seed": 5070,
    "eval_batches": 0,
    "validation_interval": 0,
    "checkpoint_interval": 250,
    "inference_batch_size": 1,
    "logging_interval": 25,
    "minimum_free_disk_gb": 15,
    "stop_after_epoch": 1
  }
}
